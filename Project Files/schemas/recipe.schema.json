{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecipeKit Recipe v0.3-draft",
  "description": "Schema.org Recipe with private RecipeKit _library extension",
  "type": "object",
  "required": [
    "@context",
    "@type",
    "name",
    "recipeCategory",
    "recipeIngredient",
    "recipeInstructions",
    "_library"
  ],
  "properties": {
    "@context": {
      "const": "https://schema.org"
    },
    "@type": {
      "const": "Recipe"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "recipeCategory": {
      "type": "string",
      "enum": [
        "Breakfast",
        "Appetizers",
        "Main Dishes",
        "Side Dishes",
        "Soups & Stews",
        "Salads",
        "Breads",
        "Desserts",
        "Snacks",
        "Sauces & Condiments",
        "Beverages",
        "Basics & Components"
      ]
    },
    "recipeCuisine": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recipeYield": {
      "type": "string",
      "minLength": 1
    },
    "prepTime": {
      "type": "string",
      "pattern": "^P(?=\\d|T)(?:\\d+D)?(?:T(?:\\d+H)?(?:\\d+M)?)?$"
    },
    "cookTime": {
      "type": "string",
      "pattern": "^P(?=\\d|T)(?:\\d+D)?(?:T(?:\\d+H)?(?:\\d+M)?)?$"
    },
    "totalTime": {
      "type": "string",
      "pattern": "^P(?=\\d|T)(?:\\d+D)?(?:T(?:\\d+H)?(?:\\d+M)?)?$"
    },
    "recipeIngredient": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recipeInstructions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "_library": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "status",
        "primaryCategory",
        "ingredients",
        "source"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "captured",
            "needs_review",
            "validated"
          ]
        },
        "primaryCategory": {
          "type": "string",
          "enum": [
            "Breakfast",
            "Appetizers",
            "Main Dishes",
            "Side Dishes",
            "Soups & Stews",
            "Salads",
            "Breads",
            "Desserts",
            "Snacks",
            "Sauces & Condiments",
            "Beverages",
            "Basics & Components"
          ]
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "yield": {
          "type": "object",
          "required": [
            "quantity",
            "unit"
          ],
          "properties": {
            "quantity": {
              "type": "string"
            },
            "unit": {
              "type": "string"
            }
          }
        },
        "ingredients": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ingredient"
          }
        },
        "variations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "description"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "source": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string"
            }
          }
        },
        "assets": {
          "type": "object"
        },
        "timeLabels": {
          "type": "object",
          "description": "Optional source-faithful human labels for ISO 8601 duration fields; e.g., Bake for cookTime",
          "properties": {
            "prepTime": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "cookTime": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "totalTime": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "$defs": {
    "ingredient": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "quantity": {
          "type": "string"
        },
        "quantityMax": {
          "type": "string"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "tsp",
            "tbsp",
            "cup",
            "fl oz",
            "oz",
            "lb",
            "g",
            "kg",
            "mL",
            "L",
            "pinch",
            "dash",
            "clove",
            "can",
            "package",
            "stick",
            "slice",
            "piece",
            null
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "preparation": {
          "type": "string"
        },
        "preparationPosition": {
          "enum": [
            "before",
            "after"
          ]
        },
        "note": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "@type",
        "text"
      ],
      "properties": {
        "@type": {
          "const": "HowToStep"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
